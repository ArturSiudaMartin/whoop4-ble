<?xml version="1.0" encoding="utf-8"?>
<!-- Bloop mark: an open progress ring with a single pulse "bloop" inside. Original artwork. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- ring, open at the top-right -->
    <path android:strokeColor="#34D399" android:strokeWidth="6" android:strokeLineCap="round"
        android:pathData="M68.5,32.2 A26,26 0 1,1 54,28" />
    <!-- pulse -->
    <path android:strokeColor="#FFFFFF" android:strokeWidth="4.5" android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36,56 L45,56 L50,46 L57,64 L62,54 L72,54" />
    <!-- the "bloop" dot at the ring's open end -->
    <path android:fillColor="#FACC15" android:pathData="M74,31 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
</vector>
